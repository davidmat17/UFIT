# Copia este archivo como .env y reemplaza los valores con los del
# proyecto de Supabase (Settings -> API Keys).
#
# El .env NO se sube al repositorio: está en el .gitignore.
# Este .env.example sí, para que el otro sepa qué variables hacen falta.
#
# Si copias las llaves desde el botón "Connect" del panel de Supabase,
# te las entrega con el prefijo NEXT_PUBLIC_ (viene de Next.js). El
# código acepta las dos formas, así que puedes dejarlas tal cual.

SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
